# Baza de date (SQLite local; în producție se poate folosi PostgreSQL)
DATABASE_URL="file:./prisma/dev.db"

# Secret pentru sesiuni și link-uri semnate (minim 32 de caractere aleatorii)
AUTH_SECRET="schimba-acest-secret-cu-unul-lung-si-aleator-000000"

# Adresa publică a site-ului (pentru link-uri în email/SMS)
APP_URL="http://localhost:3000"

# Email (SMTP). Dacă SMTP_HOST lipsește, emailurile sunt doar afișate în consolă.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Dental Arena <office@dentalarena.ro>"
CLINIC_NOTIFY_EMAIL="office@dentalarena.ro"

# SMS: "console" (implicit) sau numele unui furnizor implementat
SMS_PROVIDER="console"

# Secret pentru apelarea /api/cron/reminders
CRON_SECRET="schimba-si-acest-secret"
