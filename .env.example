# Copiați acest fișier în .env și completați valorile. Toate variabilele sunt validate de src/lib/env.ts.

# Baza de date (SQLite local; în producție se poate folosi PostgreSQL)
DATABASE_URL="file:./prisma/dev.db"

# Secret pentru sesiuni și link-uri semnate (minim 32 de caractere aleatorii).
# Generați unul cu: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="schimba-acest-secret-cu-unul-lung-si-aleator-000000"

# Cheia de criptare pentru CNP (AES-256-GCM): exact 32 de octeți, în base64.
# Valoarea de mai jos este DOAR pentru dezvoltare; în producție este refuzată.
# Generați una cu: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY="AP+cmG7JW7BMoeLeolh6r2gfLeQQ8Oaf29Uo+fbhYh8="

# Adresa publică a site-ului (pentru link-uri în email/SMS)
APP_URL="http://localhost:3000"

# Email (SMTP). Dacă SMTP_HOST lipsește, emailurile sunt doar afișate în consolă.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Dental Arena <office@dentalarena.ro>"
CLINIC_NOTIFY_EMAIL="office@dentalarena.ro"

# SMS: "console" (implicit) sau numele unui furnizor implementat
SMS_PROVIDER="console"

# Secret pentru apelarea /api/cron/* (antet Authorization: Bearer ...)
CRON_SECRET="schimba-si-acest-secret"

# Directorul pentru documentele pacienților (în afara public/, ignorat de git)
STORAGE_DIR="./storage"

# Furnizorul e-Factura: "none" (implicit) până la alegerea unei integrări
EINVOICE_PROVIDER="none"

# Parola conturilor create de seed (implicit: parola-demo-2026)
SEED_PASSWORD=""

# Date demonstrative la seed: "0" le dezactivează (implicit: active)
SEED_DEMO="1"
